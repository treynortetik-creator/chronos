<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Chronos tick. Rendered by install.sh. Runs every 5 minutes; the tick decides what is due. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>io.github.chronos.tick</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__INSTALL_DIR__/bin/chronos-tick.sh</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>CHRONOS_CONFIG</key><string>__CONFIG__</string>
  </dict>
  <key>StartInterval</key><integer>300</integer>
  <key>RunAtLoad</key><true/>
  <key>AbandonProcessGroup</key><true/>
  <key>ProcessType</key><string>Background</string>
  <key>StandardOutPath</key><string>__HOME_DIR__/logs/launchd.out</string>
  <key>StandardErrorPath</key><string>__HOME_DIR__/logs/launchd.err</string>
</dict>
</plist>
